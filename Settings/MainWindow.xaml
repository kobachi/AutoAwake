<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Kobachi.AutoAwake.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kobachi.AutoAwake"
    xmlns:controls="using:Kobachi.AutoAwake.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kobachi.AutoAwake.Models"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Uid="AppTitleBar" x:Name="AppTitleBar"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <InfoBar x:Uid="AutoAwakeNotRunningNotice" x:Name="AutoAwakeNotRunningNotice" Grid.Row="1"
                 Severity="Informational" HorizontalAlignment="Stretch" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Uid="StartAutoAwakeButton" Click="StartAutoAwake_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar x:Uid="StartupNotice" x:Name="StartupNotice" Grid.Row="2"
                 Severity="Informational" HorizontalAlignment="Stretch" IsClosable="False" />

        <NavigationView x:Name="Navigation" Grid.Row="3"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="GeneralNavigation" x:Name="GeneralNavigation" Icon="Setting" />
                <NavigationViewItem x:Uid="CpuNavigation" x:Name="CpuNavigation" Icon="ReportHacked" />
                <NavigationViewItem x:Uid="ApplicationsNavigation" x:Name="ApplicationsNavigation" Icon="AllApps" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="AboutNavigation" x:Name="AboutNavigation" Icon="Help" />
            </NavigationView.FooterMenuItems>
            <Grid Padding="24">
                <ScrollViewer x:Name="GeneralContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="IntervalLabel" VerticalAlignment="Center" />
                        <NumberBox x:Uid="IntervalInput" x:Name="IntervalInput"
                                   Width="140" Minimum="1" Maximum="86400" SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind Settings.Interval, Mode=OneWay}"
                                   ValueChanged="IntervalInput_ValueChanged" />
                        <TextBlock x:Uid="IntervalUnit" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Uid="SuppressWindowsUpdate" IsChecked="{x:Bind Settings.SuppressWindowsUpdate, Mode=TwoWay}" />
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="StartupHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="RegisterStartup" x:Name="RegisterStartup" IsEnabled="False" Click="RegisterStartup_Click" />
                            <Button x:Uid="RemoveStartup" x:Name="RemoveStartup" IsEnabled="False" Click="RemoveStartup_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="ShortcutHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Uid="ShortcutAuto" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <controls:HotkeyBox x:Name="AutoHotkey" x:Uid="ShortcutAutoBox" Grid.Column="1" HorizontalAlignment="Right" Value="{x:Bind Settings.Hotkeys.Auto, Mode=OneWay}" />
                            <TextBlock x:Uid="ShortcutNoSleep" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <controls:HotkeyBox x:Name="NoSleepHotkey" x:Uid="ShortcutNoSleepBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Value="{x:Bind Settings.Hotkeys.NoSleep, Mode=OneWay}" />
                            <TextBlock x:Uid="ShortcutKeepDisplay" Grid.Row="2" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <controls:HotkeyBox x:Name="KeepDisplayHotkey" x:Uid="ShortcutKeepDisplayBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Value="{x:Bind Settings.Hotkeys.KeepDisplay, Mode=OneWay}" />
                            <TextBlock x:Uid="ShortcutKeepUnlocked" Grid.Row="3" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <controls:HotkeyBox x:Name="KeepUnlockedHotkey" x:Uid="ShortcutKeepUnlockedBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Value="{x:Bind Settings.Hotkeys.KeepUnlocked, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="CpuContent" Spacing="20" VerticalAlignment="Top" Visibility="Collapsed">
                    <CheckBox x:Uid="CpuEnabled" x:Name="CpuEnabled"
                              IsChecked="{x:Bind Settings.CpuUsageEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="CpuThresholdLabel" VerticalAlignment="Center" />
                        <Slider x:Uid="CpuThresholdSlider" x:Name="CpuThresholdSlider"
                                Width="200" Minimum="0" Maximum="100" StepFrequency="1"
                                IsEnabled="{x:Bind Settings.CpuUsageEnabled, Mode=OneWay}"
                                Value="{x:Bind Settings.CpuUsageThreshold, Mode=OneWay}"
                                ValueChanged="CpuThresholdSlider_ValueChanged" />
                        <NumberBox x:Uid="CpuThresholdInput" x:Name="CpuThresholdInput"
                                   Width="110" Minimum="0" Maximum="100" SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.CpuUsageEnabled, Mode=OneWay}"
                                   Value="{x:Bind Settings.CpuUsageThreshold, Mode=OneWay}"
                                   ValueChanged="CpuThresholdInput_ValueChanged" />
                        <TextBlock Text="%" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="CpuActionLabel" VerticalAlignment="Center" />
                        <ComboBox x:Uid="CpuAction" x:Name="CpuAction" MinWidth="200"
                                  IsEnabled="{x:Bind Settings.CpuUsageEnabled, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ActionIndex(Settings.CpuUsageAction), Mode=OneWay}"
                                  SelectionChanged="CpuAction_SelectionChanged">
                            <ComboBoxItem x:Uid="ActionNoSleep" />
                            <ComboBoxItem x:Uid="ActionKeepDisplay" />
                            <ComboBoxItem x:Uid="ActionKeepUnlocked" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="ApplicationsContent" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Uid="AddApplicationButton" x:Name="AddApplication" HorizontalAlignment="Right" Click="AddApplication_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock x:Uid="AddApplication" />
                        </StackPanel>
                    </Button>
                    <ListView x:Name="ApplicationList" Grid.Row="1" SelectionMode="None"
                              HorizontalContentAlignment="Stretch" AllowDrop="True"
                              DragOver="ApplicationList_DragOver" Drop="ApplicationList_Drop"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{x:Bind Settings.Applications, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ApplicationSettings">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="180" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SectionName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SectionName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Path, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <!-- Measure every localized action so each row reserves the same Auto width. -->
                                        <Grid Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                            <ComboBox MinWidth="220" IsTabStop="False" SelectedIndex="0">
                                                <ComboBoxItem x:Uid="ActionNoSleep" />
                                            </ComboBox>
                                            <ComboBox MinWidth="220" IsTabStop="False" SelectedIndex="0">
                                                <ComboBoxItem x:Uid="ActionKeepDisplay" />
                                            </ComboBox>
                                            <ComboBox MinWidth="220" IsTabStop="False" SelectedIndex="0">
                                                <ComboBoxItem x:Uid="ActionKeepUnlocked" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <ComboBox x:Uid="ApplicationAction" MinWidth="220" HorizontalAlignment="Stretch"
                                                      SelectedIndex="{x:Bind ActionIndex, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="ActionNoSleep" />
                                                <ComboBoxItem x:Uid="ActionKeepDisplay" />
                                                <ComboBoxItem x:Uid="ActionKeepUnlocked" />
                                            </ComboBox>
                                            <CheckBox IsChecked="{x:Bind VisibleWindowOnly, Mode=TwoWay}">
                                                <TextBlock x:Uid="ApplicationVisibleWindowOnly" TextWrapping="NoWrap" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Uid="DeleteApplicationButton" Grid.Column="3" VerticalAlignment="Center" Click="DeleteApplication_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Delete" />
                                            <TextBlock x:Uid="DeleteApplication" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <StackPanel x:Name="AboutContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="AboutTitle" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="AboutCopyright" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
