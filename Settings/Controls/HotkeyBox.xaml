<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Kobachi.AutoAwake.Controls.HotkeyBox"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Kobachi.AutoAwake.Controls">
	<Grid>
		<Button x:Name="CaptureButton" MinWidth="200"
				HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
				Click="CaptureButton_Click" LostFocus="CaptureButton_LostFocus"
				PreviewKeyDown="CaptureButton_PreviewKeyDown" PreviewKeyUp="CaptureButton_PreviewKeyUp">
			<TextBlock x:Name="DisplayText" TextTrimming="CharacterEllipsis" />
		</Button>
		<controls:CaptureTeachingTip x:Name="CaptureTip" x:Uid="HotkeyPrompt"
					 Target="{x:Bind CaptureButton}" IsLightDismissEnabled="False"
					 Closed="CaptureTip_Closed" />
		<TeachingTip x:Name="UnavailableTip" x:Uid="HotkeyUnavailable"
					 Target="{x:Bind CaptureButton}" IsLightDismissEnabled="False" />
	</Grid>
</UserControl>
