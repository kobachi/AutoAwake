#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_CLOSED ICON "closed.ico"
IDI_OPEN ICON "open.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_TITLE "AutoAwake"
    IDS_EXIT "Exit"
    IDS_MENU_CREATE_ERROR "Could not create the tray menu."
    IDS_MENU_DISPLAY_ERROR "Could not display the tray menu."
    IDS_TRAY_RESTORE_ERROR "Could not restore the tray icon."
    IDS_TASKBAR_MESSAGE_ERROR "Could not register the taskbar message."
    IDS_ICON_LOAD_ERROR "Could not load the tray icon."
    IDS_WINDOW_CLASS_ERROR "Could not register the window class."
    IDS_WINDOW_CREATE_ERROR "Could not create the tray window."
    IDS_TRAY_ADD_ERROR "Could not add the tray icon."
    IDS_MESSAGE_LOOP_ERROR "The message loop failed."
    IDS_SETTINGS_IO_ERROR "Could not access the settings file in %APPDATA%\\AutoAwake."
    IDS_SETTINGS_ENCODING_ERROR "The settings file must use UTF-16 LE with a BOM."
    IDS_SETTINGS_VALUE_ERROR "General/CpuUsageEnabled must be 0 or 1."
    IDS_SETTINGS_INTERVAL_ERROR "General/Interval must be a whole number between 1 and 86400 seconds."
    IDS_SETTINGS_CPU_THRESHOLD_ERROR "General/CpuUsageThreshold must be a whole number from 0 to 100."
    IDS_SETTINGS_CPU_ACTION_ERROR "General/CpuUsageAction must be NoSleep, KeepDisplay or KeepUnlocked."
    IDS_SETTINGS_WATCH_ERROR "Could not monitor the settings directory. AutoAwake will exit."
    IDS_CPU_COUNTER_ERROR "Could not read the CPU performance counter. AutoAwake will exit."
    IDS_POWER_REQUEST_ERROR "Could not change the sleep prevention request. AutoAwake will exit."
    IDS_CPU_TIMER_ERROR "Could not start the CPU monitoring timer. AutoAwake will exit."
    IDS_TRAY_UPDATE_ERROR "Could not update the tray icon. AutoAwake will exit."
    IDS_SETTINGS_APPLICATION_PATH_ERROR "Each application section must have an absolute executable Path."
    IDS_SETTINGS_APPLICATION_ACTION_ERROR "Each application section must have an Action of NoSleep, KeepDisplay or KeepUnlocked."
    IDS_APPLICATION_MONITOR_ERROR "Could not inspect a matching process or enumerate processes or windows. AutoAwake will exit."
    IDS_APPLICATION_TIMER_ERROR "Could not start the application monitoring timer. AutoAwake will exit."
    IDS_SETTINGS_APPLICATION_VISIBLE_WINDOW_ERROR "Application VisibleWindowOnly must be 0 or 1."
    IDS_SETTINGS_LAUNCH_ERROR "Could not launch AutoAwakeSettings.exe from the AutoAwake folder."
    IDS_INSTANCE_ERROR "Could not check whether AutoAwake is already running."
    IDS_POWER_REASON "Prevent screen saver and idle lock while an AutoAwake condition is active"
    IDS_SETTINGS_UPDATE_ERROR "General/SuppressWindowsUpdate must be 0 or 1."
    IDS_UPDATE_ERROR "Could not change or restore Windows Update settings. Administrator access may be required, or another session may be using them. AutoAwake will exit; retry as administrator to recover."
    IDS_UPDATE_ROLLBACK_ERROR "Windows Update rollback failed. AutoAwake will retry cleanup while exiting; if needed, restart as administrator to restore the saved settings."
    IDS_MENU_AUTO "Auto"
    IDS_MENU_NO_SLEEP "Prevent sleep"
    IDS_MENU_KEEP_DISPLAY "Prevent display off"
    IDS_MENU_KEEP_UNLOCKED "Prevent screen saver and lock"
    IDS_SETTINGS_HOTKEY_ERROR "General/Hotkey* must be Modifier+Key (Ctrl, Alt, Shift or Win plus A-Z, 0-9, F1-F24, Space, Enter, Tab, Esc, arrows, Home, End, PageUp, PageDown, Insert, Delete or Num0-Num9) and must not be duplicated."
    IDS_HOTKEY_REGISTER_ERROR "Could not register shortcut keys. Another application may be using them:"
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    IDS_TITLE "AutoAwake"
    IDS_EXIT "終了"
    IDS_MENU_CREATE_ERROR "トレイメニューを作成できませんでした。"
    IDS_MENU_DISPLAY_ERROR "トレイメニューを表示できませんでした。"
    IDS_TRAY_RESTORE_ERROR "トレイアイコンを復元できませんでした。"
    IDS_TASKBAR_MESSAGE_ERROR "タスクバーのメッセージを登録できませんでした。"
    IDS_ICON_LOAD_ERROR "トレイアイコンを読み込めませんでした。"
    IDS_WINDOW_CLASS_ERROR "ウィンドウクラスを登録できませんでした。"
    IDS_WINDOW_CREATE_ERROR "ウィンドウを作成できませんでした。"
    IDS_TRAY_ADD_ERROR "トレイアイコンを追加できませんでした。"
    IDS_MESSAGE_LOOP_ERROR "メッセージループでエラーが発生しました。"
    IDS_SETTINGS_IO_ERROR "%APPDATA%\\AutoAwake の設定ファイルにアクセスできませんでした。"
    IDS_SETTINGS_ENCODING_ERROR "設定ファイルは BOM 付き UTF-16 LE で保存してください。"
    IDS_SETTINGS_VALUE_ERROR "General/CpuUsageEnabled には 0 または 1 を指定してください。"
    IDS_SETTINGS_INTERVAL_ERROR "General/Interval には 1 から 86400 までの整数を秒単位で指定してください。"
    IDS_SETTINGS_CPU_THRESHOLD_ERROR "General/CpuUsageThreshold には 0 から 100 までの整数を指定してください。"
    IDS_SETTINGS_CPU_ACTION_ERROR "General/CpuUsageAction には NoSleep、KeepDisplay または KeepUnlocked を指定してください。"
    IDS_SETTINGS_WATCH_ERROR "設定フォルダーを監視できません。AutoAwake を終了します。"
    IDS_CPU_COUNTER_ERROR "CPU のパフォーマンスカウンターを読み取れません。AutoAwake を終了します。"
    IDS_POWER_REQUEST_ERROR "スリープ防止要求を変更できません。AutoAwake を終了します。"
    IDS_CPU_TIMER_ERROR "CPU 監視タイマーを開始できません。AutoAwake を終了します。"
    IDS_TRAY_UPDATE_ERROR "トレイアイコンを更新できません。AutoAwake を終了します。"
    IDS_SETTINGS_APPLICATION_PATH_ERROR "各アプリのセクションには実行ファイルの絶対パスを Path に指定してください。"
    IDS_SETTINGS_APPLICATION_ACTION_ERROR "各アプリのセクションの Action には NoSleep、KeepDisplay または KeepUnlocked を指定してください。"
    IDS_APPLICATION_MONITOR_ERROR "プロセスまたはウィンドウを列挙するか、対象のプロセスを確認できません。AutoAwake を終了します。"
    IDS_APPLICATION_TIMER_ERROR "アプリ監視タイマーを開始できません。AutoAwake を終了します。"
    IDS_SETTINGS_APPLICATION_VISIBLE_WINDOW_ERROR "アプリの VisibleWindowOnly には 0 または 1 を指定してください。"
    IDS_SETTINGS_LAUNCH_ERROR "AutoAwake と同じフォルダーの AutoAwakeSettings.exe を起動できませんでした。"
    IDS_INSTANCE_ERROR "AutoAwake が既に起動しているか確認できませんでした。"
    IDS_POWER_REASON "AutoAwake の条件が有効な間、スクリーンセーバーと自動ロックを防止"
    IDS_SETTINGS_UPDATE_ERROR "General/SuppressWindowsUpdate には 0 または 1 を指定してください。"
    IDS_UPDATE_ERROR "Windows Update の設定を変更または復元できません。管理者権限が必要か、別のセッションで使用中です。管理者として再実行して復元してください。"
    IDS_UPDATE_ROLLBACK_ERROR "Windows Update 設定の復元に失敗しました。終了時に再試行します。必要に応じて管理者として再起動してください。"
    IDS_MENU_AUTO "自動"
    IDS_MENU_NO_SLEEP "スリープ防止"
    IDS_MENU_KEEP_DISPLAY "画面オフ防止"
    IDS_MENU_KEEP_UNLOCKED "スクリーンセーバーと自動ロックを防止"
    IDS_SETTINGS_HOTKEY_ERROR "General/Hotkey* には、修飾キー (Ctrl、Alt、Shift、Win) とキー (A-Z、0-9、F1-F24、Space、Enter、Tab、Esc、矢印、Home、End、PageUp、PageDown、Insert、Delete、Num0-Num9) を + でつないで指定してください。重複は指定できません。"
    IDS_HOTKEY_REGISTER_ERROR "ショートカットキーを登録できませんでした。他のアプリが使用中の可能性があります:"
END
